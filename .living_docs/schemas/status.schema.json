{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/GuardianBob/living-docs/schemas/status.schema.json",
  "title": "Status Shard (Singleton)",
  "description": "The only unsharded living doc. Overwritten by every agent on every task. Path: .living_docs/status/current.md",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated", "active_task"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "updated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp."
    },
    "active_task": {
      "description": "Currently in-flight task ID, or null if idle.",
      "oneOf": [
        { "type": "string", "pattern": "^T-\\d{3,}$" },
        { "type": "null" }
      ]
    },
    "last_completed_task": {
      "oneOf": [
        { "type": "string", "pattern": "^T-\\d{3,}$" },
        { "type": "null" }
      ]
    }
  }
}
